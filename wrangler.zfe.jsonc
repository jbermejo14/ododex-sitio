{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker propio de ZFE & Crit'Air (Francia): unas pocas decenas de ficheros. Va aparte del
  // Worker principal para poder publicarla y actualizar sus datos sin redesplegar el resto.
  // La route lleva /fr/zfe* a este Worker; se ejecuta antes que el dominio personalizado
  // del Worker principal (wrangler.jsonc).
  "name": "ododex-zfe",
  "compatibility_date": "2026-11-03",
  "routes": [{ "pattern": "ododex.com/fr/zfe*", "zone_name": "ododex.com" }],
  // Sin URL *.workers.dev ni URLs de vista previa: llevan el nombre de la cuenta.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist-zfe",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
