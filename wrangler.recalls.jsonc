{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker propio de recalls (inglés): cada idioma de recalls-web se publica en su Worker.
  // La route lleva /en/recalls* a este Worker; se ejecuta antes que el dominio
  // personalizado del Worker principal (wrangler.jsonc).
  "name": "ododex-recalls",
  "compatibility_date": "2026-11-03",
  "routes": [{ "pattern": "ododex.com/en/recalls*", "zone_name": "ododex.com" }],
  // Sin URL *.workers.dev ni URLs de vista previa: llevan el nombre de la cuenta.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist-recalls",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
