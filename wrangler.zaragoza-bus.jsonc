{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker propio del autobús de Zaragoza. La route lleva /es/zaragoza-bus* a este Worker; se
  // ejecuta antes que el dominio personalizado del Worker principal (wrangler.jsonc).
  "name": "ododex-zaragoza-bus",
  // Único Worker con código: proxy de tiempos reales (Avanza, con respaldo en DNDzgz). Sin empaquetar porque esbuild está bloqueado.
  "main": "workers/zaragoza-bus.mjs",
  "no_bundle": true,
  "compatibility_date": "2026-11-03",
  "routes": [{ "pattern": "ododex.com/es/zaragoza-bus*", "zone_name": "ododex.com" }],
  // Sin URL *.workers.dev ni URLs de vista previa: llevan el nombre de la cuenta.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist-zaragoza-bus",
    "binding": "ASSETS",
    // Solo la API ejecuta código; el resto lo sirve Cloudflare como estático.
    "run_worker_first": ["/es/zaragoza-bus/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
