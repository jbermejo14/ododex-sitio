{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker propio de Permis à points & stages (Francia).
  // La route lleva /fr/permis-points* a este Worker.
  "name": "ododex-permis-points",
  "compatibility_date": "2026-11-03",
  "routes": [{ "pattern": "ododex.com/fr/permis-points*", "zone_name": "ododex.com" }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist-permis-points",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
