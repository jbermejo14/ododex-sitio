{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker propio de prix-carburants (Francia): unas 15 500 páginas y 1 056 particiones de histórico;
  // el plan gratuito admite 20 000 ficheros por Worker.
  // La route lleva /fr/prix-carburants* a este Worker; se ejecuta antes que el dominio
  // personalizado del Worker principal (wrangler.jsonc).
  "name": "ododex-prix-carburants",
  "compatibility_date": "2026-11-03",
  "routes": [{ "pattern": "ododex.com/fr/prix-carburants*", "zone_name": "ododex.com" }],
  // Sin URL *.workers.dev ni URLs de vista previa: llevan el nombre de la cuenta.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist-prix-carburants",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
