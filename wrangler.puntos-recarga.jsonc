{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker propio de puntos de recarga: unas 14 500 páginas; el plan gratuito admite 20 000 ficheros por Worker.
  // La route lleva /es/puntos-recarga* a este Worker; se ejecuta antes que el dominio
  // personalizado del Worker principal (wrangler.jsonc).
  "name": "ododex-puntos-recarga",
  "compatibility_date": "2026-11-03",
  "routes": [{ "pattern": "ododex.com/es/puntos-recarga*", "zone_name": "ododex.com" }],
  // Sin URL *.workers.dev ni URLs de vista previa: llevan el nombre de la cuenta.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist-puntos-recarga",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
